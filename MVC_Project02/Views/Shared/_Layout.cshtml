@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Route Gym</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app">

        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="brand">
                <div class="brand-logo">R</div>
                <div>
                    <div class="brand-name">ROUTE</div>
                    <div class="brand-sub">Gym Management</div>
                </div>
            </div>

            <nav class="nav-section">
                <div class="nav-title">OVERVIEW</div>
                <a class="nav-item @(ctrl == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i> Dashboard
                </a>

                <div class="nav-title">PEOPLE</div>
                <a class="nav-item @(ctrl == "Members" ? "active" : "")" asp-controller="Members" asp-action="Index">
                    <i class="bi bi-people"></i> Members
                </a>
                <a class="nav-item @(ctrl == "Trainers" ? "active" : "")" asp-controller="Trainers" asp-action="Index">
                    <i class="bi bi-person-badge"></i> Trainers
                </a>

                <div class="nav-title">GYM</div>
                <a class="nav-item @(ctrl == "Plans" ? "active" : "")" asp-controller="Plans" asp-action="Index">
                    <i class="bi bi-tag"></i> Plans
                </a>
                <a class="nav-item @(ctrl == "Memberships" ? "active" : "")" asp-controller="Memberships" asp-action="Index">
                    <i class="bi bi-card-list"></i> Memberships
                </a>
                <a class="nav-item @(ctrl == "Sessions" ? "active" : "")" asp-controller="Sessions" asp-action="Index">
                    <i class="bi bi-calendar-check"></i> Sessions
                </a>
            </nav>

            <div class="sidebar-footer">
                <span>.NET Track</span>
                <span class="muted">Route Academy</span>
            </div>
        </aside>

        <!-- Main -->
        <div class="main">
            <header class="topbar">
                <div class="breadcrumb-x">
                    <a asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i></a>
                    <span class="sep">/</span>
                    <span>@ViewData["Title"]</span>
                </div>
                <div class="date-box">
                    <i class="bi bi-calendar3"></i>
                    @DateTime.Now.ToString("dddd, dd MMM yyyy")
                </div>
            </header>

            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
    <script>
            document.querySelectorAll('.toast-r').forEach(t => {
                t.querySelector('button').addEventListener('click', () => t.remove());
                setTimeout(() => t.remove(), 5000);
            });

            document.querySelectorAll('form[data-confirm]').forEach(f => {
                f.addEventListener('submit', e => {
                    if (!confirm(f.dataset.confirm)) e.preventDefault();
                });
            });
    </script>
</body>
</html>